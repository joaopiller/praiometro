# Copie para .env e ajuste. Todas as variáveis são opcionais.

# MongoDB (no docker compose use mongodb://mongo:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=praiometro

# Pasta onde o worker grava os dados gerados (leituras, histórico, maré). Padrão: backend/var
# DATA_DIR=var

# Porta da API
PORT=8000

# Web Client ID do Google OAuth. MUITO IMPORTANTE em produção: sem ele, a API
# aceita tokens emitidos para qualquer app Google.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Bundle ID do app iOS (audiência do login com Apple)
APPLE_BUNDLE_ID=com.praiometro.app

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
