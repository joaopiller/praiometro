# Copie para .env (ou rode `npm run setup:env`). Nada aqui é segredo.

# URL da API. No emulador Android, http://10.0.2.2:8000 aponta para o seu computador.
# Em um celular físico, use o IP do computador na rede local (ex.: http://192.168.0.10:8000).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Web Client ID do Google OAuth (o mesmo GOOGLE_CLIENT_ID do backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# E-mail de contato exibido na aba "Sobre" (opcional)
EXPO_PUBLIC_CONTACT_EMAIL=
